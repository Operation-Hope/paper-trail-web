# Paper Trail Frontend Environment Variables

# Backend API URL
# Optional - defaults to http://localhost:5001 if not set
# Production: Set to your deployed backend URL
VITE_API_BASE_URL=

# Dataset base URL (FEC + VoteView Parquet files, see scripts/data_sync.py)
# Optional - defaults to the production Hugging Face dataset repo.
# Point at a local server (e.g. http://localhost:8799) to test locally-built data.
VITE_DATA_BASE_URL=

# Enable Mock Service Worker (MSW) for development
# Set to 'true' to use mock data instead of real backend
VITE_ENABLE_MOCKS=
